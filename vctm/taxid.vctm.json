{
  "vct": "eu.europa.ec.eudi.taxid.1",
  "name": "Tax ID SD-JWT VC Type Metadata",
  "description": "Tax Identification Number (TaxID) per the WE BUILD rb-taxid attestation rulebook.",
  "display": [
    {
      "locale": "en-US",
      "name": "Tax ID",
      "description": "Structured, verifiable evidence of a natural person's tax identification number within a national tax system, bound to their identity.",
      "rendering": {
        "simple": {
          "background_color": "#FFFFFF",
          "text_color": "#00349f",
          "logo": {
            "uri": "data:image/png;base64,",
            "alt_text": "WE BUILD"
          }
        }
      }
    }
  ],
  "claims": [
    {
      "path": ["tax_number"],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Tax number",
          "description": "Character string that enables the tax authority to uniquely assign the User within the national tax system. The format and structure of this string varies per Member State (combination of letters and digits)."
        }
      ]
    },
    {
      "path": ["affiliation_country"],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Tax residence country",
          "description": "Alpha-2 country code of the User's country of tax residence (i.e. the Member State whose national tax system assigns the tax_number)."
        }
      ]
    },
    {
      "path": ["family_name"],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Family name",
          "description": "Current last name(s) or surname(s) of the User."
        }
      ]
    },
    {
      "path": ["given_name"],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Given name",
          "description": "Current first name(s), including middle name(s), of the User."
        }
      ]
    },
    {
      "path": ["birth_date"],
      "mandatory": true,
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Date of birth",
          "description": "Day, month, and year on which the User was born. Expressed as a date (not a datetime)."
        }
      ]
    },
    {
      "path": ["church_tax_ID"],
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Church tax ID",
          "description": "Character string made up of numbers and letters, identifying the User for church tax purposes."
        }
      ]
    },
    {
      "path": ["iban"],
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "IBAN",
          "description": "IBAN (International Bank Account Number) registered with the tax authority for the User. Formatted in accordance with ISO 13616."
        }
      ]
    },
    {
      "path": ["issuing_jurisdiction"],
      "sd": "always",
      "display": [
        {
          "locale": "en-US",
          "label": "Issuing jurisdiction",
          "description": "Country subdivision code of the jurisdiction that issued the TaxID attestation, as defined in ISO 3166-2:2020 Clause 8."
        }
      ]
    },
    {
      "path": ["attestation_legal_category"],
      "mandatory": true,
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Legal category",
          "description": "Indicates the legal category of the attestation."
        }
      ]
    },
    {
      "path": ["issuance_date"],
      "mandatory": true,
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Issuance date",
          "description": "Date and time on which the TaxID attestation was issued."
        }
      ]
    },
    {
      "path": ["expiry_date"],
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Expiry date",
          "description": "Date and time after which the TaxID attestation is no longer valid."
        }
      ]
    },
    {
      "path": ["issuing_authority"],
      "mandatory": true,
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Issuing authority",
          "description": "Name of the administrative authority that issued this TaxID attestation. Where no separate authority is authorised to issue TaxID attestations in the Member State, this field SHALL contain the ISO 3166-1 Alpha-2 country code of the respective Member State."
        }
      ]
    },
    {
      "path": ["issuing_country"],
      "mandatory": true,
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Issuing country",
          "description": "Alpha-2 country code (ISO 3166-1) of the TaxID attestation provider's country or territory."
        }
      ]
    },
    {
      "path": ["trust_anchor_location"],
      "sd": "never",
      "display": [
        {
          "locale": "en-US",
          "label": "Trust anchor location",
          "description": "The URL at which a machine-readable version of the trust anchor to be used for verifying this TaxID attestation can be found or looked up."
        }
      ]
    }
  ]
}
